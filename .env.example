# Flask Security & Environment
FLASK_DEBUG=1
SECRET_KEY=your-super-secret-key-here

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-db-password-here
DB_NAME=expense_tracker

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email / SMTP Configuration (Required for Live Password Reset Emails)
# For Gmail: Use smtp.gmail.com, port 587, and a 16-character Gmail App Password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_USE_TLS=true
MAIL_FROM=Finora Support <your-email@gmail.com>
APP_BASE_URL=http://127.0.0.1:5000

